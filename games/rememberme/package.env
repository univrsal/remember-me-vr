# Used by tools/package.sh.
PACKAGE_NAME="RememberMeVR"
# Where the mod files go, relative to the game's install folder.
PACKAGE_DIR="Binaries/Win32"
# Build outputs (from build/<preset>/games/rememberme/) placed in PACKAGE_DIR.
PACKAGE_FILES="dinput8.dll RememberMeVR.ini"
# Files from games/rememberme/ placed at the zip root.
PACKAGE_DOCS="INSTALL.txt"
